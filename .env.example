# Public (safe for browser bundle)
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR-ANON-KEY"

# Public site URL used to build the QR code target. Leave empty to auto-detect
# from the browser origin (window.location.origin).
NEXT_PUBLIC_SITE_URL=""

# Optional: protect /api/admin endpoints. If empty, admin routes are open.
ADMIN_TOKEN=""

# Server-only secrets. NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY="YOUR-SERVICE-ROLE-KEY"
SUPABASE_STORAGE_BUCKET="game-uploads"

# Game defaults
GAME_TOTAL_PIECES="10"
